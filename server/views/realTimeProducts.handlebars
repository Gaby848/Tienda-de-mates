<!-- server/views/realTimeProducts.handlebars -->
<div class="container mt-4">
    <h1 class="mb-4">Productos en Tiempo Real</h1>

    <!-- Formulario para agregar productos -->
    <div class="card mb-5 shadow-sm">
        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Agregar Nuevo Producto</h3>
        </div>
        <div class="card-body">
            <form id="addProductForm" class="needs-validation" novalidate>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="title" class="form-label">Título *</label>
                        <input type="text" class="form-control" id="title" name="title" 
                               placeholder="Ej: Mate Camionero" minlength="3" required>
                        <div class="invalid-feedback">
                            El título debe tener al menos 3 caracteres
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="price" class="form-label">Precio (ARS) *</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input type="number" class="form-control" id="price" name="price" 
                                   placeholder="0.00" step="0.01" min="0.01" required>
                            <div class="invalid-feedback">
                                Ingrese un precio válido mayor a 0
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="description" class="form-label">Descripción</label>
                    <textarea class="form-control" id="description" name="description" 
                              rows="3" placeholder="Descripción detallada del producto"></textarea>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="stock" class="form-label">Stock *</label>
                        <input type="number" class="form-control" id="stock" name="stock" 
                               placeholder="0" min="0" required>
                        <div class="invalid-feedback">
                            El stock debe ser un número positivo
                        </div>
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-plus-circle me-2"></i>Agregar Producto
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Lista de productos -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h3 class="mb-0">Lista de Productos</h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th>Descripción</th>
                            <th class="text-end">Precio</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="realtimeProductsList">
                        {{#if products.length}}
                            {{#each products}}
                                <tr class="product-card" data-id="{{this.id}}">
                                    <td>
                                        <h6 class="mb-0">{{this.title}}</h6>
                                        <small class="text-muted">Código: {{this.code}}</small>
                                    </td>
                                    <td>
                                        <p class="mb-0 text-muted small">
                                            {{#if this.description}}
                                                {{this.description}}
                                            {{else}}
                                                <span class="text-muted fst-italic">Sin descripción</span>
                                            {{/if}}
                                        </p>
                                    </td>
                                    <td class="text-end fw-bold">
                                        ${{numberFormat this.price}}
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-{{#if (gt this.stock 5)}}success{{else}}warning{{/if}}">
                                            {{this.stock}} unidades
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-danger delete-product" 
                                                data-id="{{this.id}}" 
                                                title="Eliminar producto">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            {{/each}}
                        {{else}}
                            <tr>
                                <td colspan="5" class="text-center py-4">
                                    <div class="alert alert-info mb-0">
                                        <i class="bi bi-info-circle me-2"></i>
                                        No hay productos disponibles. ¡Agrega uno nuevo!
                                    </div>
                                </td>
                            </tr>
                        {{/if}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>