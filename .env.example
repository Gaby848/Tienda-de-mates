# Puerto del servidor
PORT=3000

# URI de conexión a MongoDB
# Para desarrollo local:
# MONGO_URI=mongodb://localhost:27017/tienda-de-mates

# Para MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/tienda-de-mates

MONGO_URI=mongodb://localhost:27017/tienda-de-mates

# Ambiente
NODE_ENV=development

# Configuración JWT
JWT_SECRET=secret_key_jwt
JWT_COOKIE_EXPIRES=24h

# Configuración de Email (para recuperación de contraseña)
EMAIL_SERVICE=gmail
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-de-aplicacion

# URL Frontend (para enlaces de recuperación)
FRONTEND_URL=http://localhost:3000
